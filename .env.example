# NetOps Nexus - Environment Configuration Template
# Copy to .env for local deployment (DO NOT COMMIT .env TO GIT)

# Server Configuration
PROJECT_NAME="NetOps Nexus"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:5173"

# Security & JWT Auth
# Generate secure key in production with: openssl rand -hex 32
SECRET_KEY="netops-nexus-dev-secret-key-change-in-production-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# For PostgreSQL: postgresql+asyncpg://netops:netops_secret@localhost:5432/netops_nexus
# For SQLite (Dev/Test default): sqlite+aiosqlite:///./netops_nexus.db
DATABASE_URL="sqlite+aiosqlite:///./netops_nexus.db"
SYNC_DATABASE_URL="sqlite:///./netops_nexus.db"
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Task Queue
REDIS_URL="redis://localhost:6379/0"
USE_REDIS=false

# Network Lab Mode
# In LAB mode, virtual devices, interfaces, routes, metrics and failures are simulated
LAB_MODE=true
LAB_TICK_INTERVAL_SECONDS=5
LAB_DEVICE_COUNT=24
LAB_SITE_COUNT=4

# Monitoring & Telemetry Poll Interval
TELEMETRY_POLL_INTERVAL_SECONDS=10
ALERT_EVALUATION_INTERVAL_SECONDS=15
DISCOVERY_WORKER_CONCURRENCY=10

# Security Scans
ENABLE_SECURITY_AUDIT_ON_STARTUP=true
CIS_BENCHMARK_STRICT_MODE=false

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
